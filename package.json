    "query4": "node src/queries/query4.js",
    "query6": "node src/queries/query6.js",
    "query7": "node src/queries/query7.js",
    "query8": "node src/queries/query8.js",
    "query9": "node src/queries/query9.js",
    "query10": "node src/queries/query10.js",
    "query11": "node src/queries/query11.js",
    "query12": "node src/queries/query12.js",
    "query13": "node src/queries/query13.js"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^0.303.0",
